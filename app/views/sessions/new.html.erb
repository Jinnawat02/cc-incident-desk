<% content_for :title, "Sign in · Incident Desk" %>

<div class="flex min-h-screen items-center justify-center p-6">
  <%= form_with url: session_path, class: "card form w-full max-w-100 p-8" do |form| %>
    <div class="flex flex-col gap-1">
      <div class="text-sm leading-[normal] font-bold uppercase tracking-[0.04em] text-accent">Incident Desk</div>
      <h1>Sign in</h1>
    </div>

    <%= tag.div(flash[:alert], class: "alert-error", role: "alert") if flash[:alert] %>

    <div class="field">
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, value: params[:email_address], required: true, autofocus: true,
            autocomplete: "email", placeholder: "you@company.com", class: "input" %>
    </div>

    <div class="field">
      <%= form.label :password, class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password",
            placeholder: "••••••••", maxlength: 72, class: "input" %>
    </div>

    <%= form.submit "Sign in", class: "btn btn-primary w-full" %>
  <% end %>
</div>
