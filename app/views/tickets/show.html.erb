<% content_for :title, "Ticket #{ticket_number(@ticket)} · Incident Desk" %>

<main class="max-w-[1160px] mx-auto px-6 py-8 flex flex-col gap-5">
  <%= back_to_dashboard_link %>

  <div class="flex flex-wrap items-start gap-6">
    <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-5">
      <div class="flex flex-col gap-2">
        <div class="flex flex-wrap items-center gap-2.5 text-sm text-muted">
          <span><%= ticket_number(@ticket) %></span>
          <%= status_badge(@ticket) %>
          <%= severity_badge(@ticket) %>
        </div>
        <h1><%= @ticket.title %></h1>
        <div class="text-sm text-muted">Created <%= ticket_timestamp(@ticket.created_at) %></div>
      </div>

      <section class="card p-6 leading-relaxed">
        <h2 class="section-label">Description</h2>
        <div class="whitespace-pre-wrap"><%= @ticket.description %></div>
      </section>
    </div>

    <aside class="flex-[1_1_260px]">
      <div class="card p-5 flex flex-col gap-3.5">
        <h2 class="text-base font-bold">Details</h2>
        <div class="detail">
          <span class="detail-label">Status</span>
          <span><%= status_badge(@ticket) %></span>
        </div>
        <div class="detail">
          <span class="detail-label">Assignee</span>
          <span><%= @ticket.assignee&.email_address || "Unassigned" %></span>
        </div>
        <div class="detail">
          <span class="detail-label">Severity</span>
          <span><%= severity_badge(@ticket) %></span>
        </div>
        <div class="detail">
          <span class="detail-label">Customer</span>
          <span><%= @ticket.creator.email_address %></span>
        </div>
        <div class="detail">
          <span class="detail-label">Created</span>
          <span><%= ticket_timestamp(@ticket.created_at) %></span>
        </div>
      </div>
    </aside>
  </div>
</main>
