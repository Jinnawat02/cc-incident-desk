<div id="<%= dom_id(comment) %>" class="card px-5 py-4 flex flex-col gap-1.5">
  <div class="flex flex-wrap items-center gap-2 text-sm">
    <strong class="font-semibold"><%= comment.author.email_address %></strong>
    <span class="role role-<%= comment.author.role %>"><%= comment.author.role.humanize %></span>
    <span class="text-muted"><%= ticket_timestamp(comment.created_at) %></span>
  </div>
  <div class="leading-normal whitespace-pre-wrap"><%= comment.body %></div>
</div>
