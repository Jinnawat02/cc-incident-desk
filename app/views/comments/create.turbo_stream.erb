<%= turbo_stream.append dom_id(@ticket, :comments), partial: "comments/comment", locals: { comment: @posting.comment } %>
<%= turbo_stream.update dom_id(@ticket, :comments_count), @ticket.comments.count %>
<%= turbo_stream.replace dom_id(@ticket, :comment_form), partial: "comments/form", locals: { ticket: @ticket, comment: Comment.new } %>
