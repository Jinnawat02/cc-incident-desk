<% content_for :title, "My tickets · Incident Desk" %>
<%= turbo_stream_from Current.user, :tickets %>

<main class="max-w-[1040px] mx-auto px-6 py-8 flex flex-col gap-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1>My tickets</h1>
    <%= link_to "+ New Ticket", new_ticket_path, class: "btn btn-primary" %>
  </div>

  <% if tickets.any? %>
    <div class="card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>ID</th><th>Title</th><th>Severity</th><th>Status</th><th>Created</th></tr>
          </thead>
          <tbody>
            <% tickets.each do |ticket| %>
              <tr id="<%= dom_id(ticket) %>">
                <td class="muted"><%= ticket_number(ticket) %></td>
                <td><%= link_to ticket.title, ticket, class: "title-link" %></td>
                <td><%= severity_badge(ticket) %></td>
                <td><%= render "tickets/status_badge", ticket: ticket %></td>
                <td class="muted"><%= ticket_timestamp(ticket.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="card p-6 text-muted">You have not submitted any tickets yet.</div>
  <% end %>

  <p class="hint">Status updates appear here automatically.</p>
</main>
